# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dms-city?schema=public

# --- JWT ---
# Use `openssl rand -hex 64` to generate each.
JWT_ACCESS_SECRET=replace_me_with_long_random_string_access
JWT_ACCESS_TTL=10m
JWT_REFRESH_SECRET=replace_me_with_long_random_string_refresh
JWT_REFRESH_TTL=7d

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# --- Throttling ---
THROTTLE_TTL=900000
THROTTLE_LIMIT=100

# --- File storage (local disk) ---
# Directory where uploaded attachments are stored. Resolved relative to cwd
# (the api/ folder) unless an absolute path is given. Defaults to ./uploads
UPLOAD_DIR=./uploads
# Maximum single-file upload size in bytes (default 26214400 = 25 MB)
MAX_UPLOAD_SIZE=26214400

# --- Email (SMTP) ---
# Used to deliver account-created credentials emails. When MAIL_HOST is empty,
# email sending is skipped and the UI reports that the email could not be sent.
#
# Local development: run a MailHog sink and inspect deliveries at its web UI:
#   docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#   MAIL_HOST=localhost  MAIL_PORT=1025  MAIL_FROM_ADDRESS=noreply@dms.local
MAIL_HOST=localhost
MAIL_PORT=1025
# Set MAIL_SECURE=true for port 465, false for 587 with STARTTLS.
MAIL_SECURE=false
# Set MAIL_REQUIRE_TLS=true when the server always requires STARTTLS
# (e.g. Gmail / Office 365 on port 587). Leave false for MailHog/local sinks.
MAIL_REQUIRE_TLS=false
# Leave blank if the SMTP server does not require authentication.
MAIL_USER=
MAIL_PASS=
# Sender identity shown in delivered emails.
MAIL_FROM_NAME=DMS
# Defaults to MAIL_USER if left blank.
MAIL_FROM_ADDRESS=
# Login page URL included in credential emails (defaults to local dev).
MAIL_LOGIN_URL=http://localhost:5173/login

# --- Email verification (Gmail SMTP) ---
# Used for the six-digit registration OTP. Use a Google App Password, not the
# account's normal password: https://myaccount.google.com/apppasswords
# When either value is empty, registration responds 503 and no account is kept.
NODEMAIL_USER=
NODEMAIL_PASS=
# Optional overrides. Defaults are Gmail SMTP with STARTTLS:
#   host=smtp.gmail.com port=587 secure=false requireTLS=true
# Set these only for a local SMTP capture server in automated tests.
# NODEMAIL_HOST=
# NODEMAIL_PORT=
# NODEMAIL_SECURE=
# NODEMAIL_REQUIRE_TLS=
# Sender name/address. Address defaults to NODEMAIL_USER.
# NODEMAIL_FROM_NAME=CityDocs DMS
# NODEMAIL_FROM_ADDRESS=
